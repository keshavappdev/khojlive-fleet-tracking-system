# Copy to .env locally. Never commit .env to Git.
PORT=4000
# Replace with your own local PostgreSQL connection string.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME
# Generate a strong, unpredictable secret (minimum 32 characters).
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=http://localhost:5200
# Demo users are opt-in; never enable publicly without access controls.
SEED_DEMO=false
# Required only when SEED_DEMO=true; use a unique password of >=12 characters.
SEED_DEMO_PASSWORD=YOUR_UNIQUE_DEMO_PASSWORD
